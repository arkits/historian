# Database
DATABASE_URL=postgresql://user:password@localhost:5432/historian

# Authentication
AUTH_SECRET=your-secret-key-here

# Google OAuth (for YouTube connection: liked videos sync)
# Create OAuth client at Google Cloud Console, enable YouTube Data API v3,
# add redirect URIs: http://localhost:3000/api/auth/callback/google (dev),
# https://historian-api.archit.xyz/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API URL (for client-side configuration)
# Set to production API when running locally but want to connect to prod backend
# VITE_API_URL=https://historian-api.archit.xyz

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=historian
OTEL_SAMPLE_RATE=1
OTEL_TRACING_ENABLED=true
OTEL_LOGGING_ENABLED=false

# PostHog Settings
POSTHOG_ENABLED=true
POSTHOG_FLUSH_AT=20
POSTHOG_FLUSH_INTERVAL=10000

# Sentry Settings
SENTRY_ENABLED=true
